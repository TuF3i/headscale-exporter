# Headscale base URL, without /api/v1.
# Docker Desktop (Windows/macOS): use host.docker.internal when Headscale runs on the host.
# Linux: host.docker.internal is mapped via extra_hosts in docker-compose.yml.
# If Headscale runs in another Docker network, attach this service to that network
# and use the Headscale service name instead, e.g. http://headscale:8080.
HEADSCALE_URL=http://host.docker.internal:8080

# Create one with: headscale apikeys create --expiration 90d
HEADSCALE_API_KEY=replace-with-headscale-api-key

# Optional settings
# LISTEN_ADDRESS=:9110
# TELEMETRY_PATH=/metrics
# SCRAPE_TIMEOUT=10s
# LOG_LEVEL=info
